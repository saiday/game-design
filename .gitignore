# Godot 4.x import cache (not committed; regenerated on import — companion doc §4)
.godot/

# Godot misc
export_presets.cfg
*.translation

# gdUnit4 CLI reports (regenerated each run)
reports/

# Runtime screenshot captures (regenerated; path recorded in PLAN.md, blob not committed)
captures/

# Local agent/editor tooling (machine-specific symlinks, not project content)
.antigravitycli/

# macOS folder metadata
.DS_Store

# Re-roll candidates from render_topdown_sprites.py --probe (reviewed, then discarded)
insignificant-game/docs/tools/topdown-probe/

# Editor-scan .import siblings under assets/exploration/. Deliberately narrower than the 412
# .import files this repo DOES track: those carry the uid:// identity of assets Godot actually
# loads. Nothing under exploration/ is referenced by any scene, script or asset_paths.gd entry,
# so their uid:// is never resolved and the files are pure churn.
insignificant-game/assets/exploration/**/*.import

# Python bytecode from the docs/tools scripts
__pycache__/
